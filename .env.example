# Chave da API do Claude. Sem ela, os recursos de IA ficam desligados com aviso.
ANTHROPIC_API_KEY=
# URL que recebe eventos de mudança de situação (PROMETHEUS). Opcional.
WEBHOOK_URL=
# Quantidade de equipamentos gerados pelo seed na primeira subida.
SEED_EQUIPAMENTOS=20000
ANTHROPIC_MODEL=
# Canal de eventos da central (o compose já define). Vazio: eventos entregues em memória.
REDIS_URL=
